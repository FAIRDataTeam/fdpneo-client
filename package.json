{
  "name": "fdp-client",
  "private": true,
  "version": "0.3.0",
  "description": "Reference web client for FAIR Data Point v2 — Vue 3 + TypeScript SPA.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --build",
    "generate-api": "openapi-typescript ${FDP_API_URL:-http://localhost:8000}/fdp-api/openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.59.0",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.41.0",
    "axios": "^1.7.0",
    "chart.js": "^4.4.0",
    "monaco-editor": "^0.52.2",
    "n3": "^1.21.0",
    "oidc-client-ts": "^3.1.0",
    "pinia": "^3.0.4",
    "primevue": "^4.1.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^5.1.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/n3": "^1.21.0",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "typescript": "~5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
