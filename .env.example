# Copy this file to .env and adjust for your local setup.
#
# These values match the docker compose stack in the fdp-server repository:
#   - FDP API on :8000
#   - Keycloak on :8080 with realm fdp-dev
#   - SPA dev server on :5173

VITE_FDP_API_URL=http://localhost:8000
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/fdp-dev
VITE_OIDC_CLIENT_ID=fdp-client-dev
VITE_PUBLIC_ORIGIN=http://localhost:5173

# Dot-path into the ID token where the roles array lives. Defaults to
# `realm_access.roles` (Keycloak). Common alternatives:
#   roles                                   — flat array
#   resource_access.fdp-client-dev.roles    — Keycloak per-client roles
#   https://your-tenant.example/roles       — Auth0 custom claim
# VITE_OIDC_ROLES_CLAIM=realm_access.roles
