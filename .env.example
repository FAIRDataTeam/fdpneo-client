# Copy this file to .env and adjust for your local setup.
#
# These values match the docker compose stack in the fdp-server repository:
#   - FDP API on :8000
#   - Keycloak on :8080 with realm fdp-dev
#   - SPA dev server on :5173
#
# Networking is CORS-only (no dev proxy): the SPA calls the API directly at
# VITE_FDP_API_URL. The origin you open the app at MUST match all three of:
# VITE_PUBLIC_ORIGIN below, the server's FDP_CORS_allow_origins, and the
# Keycloak redirect URI. NB: http://localhost:5173 and http://127.0.0.1:5173
# are DIFFERENT origins to the browser — don't mix them (main.ts warns in dev).

VITE_FDP_API_URL=http://localhost:8000

# OIDC is normally driven by the server's GET /config (issuer + client_id_hint),
# fetched at startup (TASKS 10.1). These VITE_OIDC_* values are the FALLBACK used
# when /config is unavailable (old server, or a 500 from a downstream outage).
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/fdp-dev
VITE_OIDC_CLIENT_ID=fdp-client
VITE_PUBLIC_ORIGIN=http://localhost:5173

# Dot-path into the ID token where the roles array lives. Defaults to
# `realm_access.roles` (Keycloak). Common alternatives:
#   roles                                   — flat array
#   resource_access.fdp-client-dev.roles    — Keycloak per-client roles
#   https://your-tenant.example/roles       — Auth0 custom claim
# VITE_OIDC_ROLES_CLAIM=realm_access.roles
